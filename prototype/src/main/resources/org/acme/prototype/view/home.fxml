<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<GridPane hgap="10.0" vgap="10.0"
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="org.acme.prototype.controller.HomeController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
    </padding>
    <Button text="Get Car List"     
        onAction="#onGetCarListClick"
        GridPane.columnIndex="0" GridPane.rowIndex="1" />
    <Label style="-fx-font: NORMAL 20 Tahoma;" text="Turbo Speed System"                
        GridPane.columnIndex="1" GridPane.rowIndex="0">
    </Label>
    <Label style="-fx-font: NORMAL 14 Tahoma;" text="Welcome to the system that will find your next car"                
        GridPane.columnIndex="1" GridPane.rowIndex="1">
    </Label>
    
</GridPane>
